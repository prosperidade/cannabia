# =============================================================
# CannabIA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do arquivo .env no repositório.
# =============================================================

# ──────────────────────────────────────────────
# BANCO DE DADOS
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/cannabia

# Pool de conexões psycopg2 (src/infra/database.py)
DB_POOL_MIN=2
DB_POOL_MAX=10

# Clínica default para rotas/jobs sem tenant explícito.
# Precisa apontar para uma row real em `clinics` (ver seed).
DEFAULT_CLINIC_ID=1

# ──────────────────────────────────────────────
# SEGURANÇA DA APLICAÇÃO
# ──────────────────────────────────────────────
SECRET_KEY=change_me_strong_random_secret_min_32_chars
ENCRYPTION_KEY=
# Gere com: python -c "from src.infra.crypto import generate_key; print(generate_key())"
# Se vazio, deriva de SECRET_KEY via HKDF (menos seguro, ok para dev)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
# SEC-1 (doc 30 Onda 1): cabecalhos HTTP de seguranca no after_request.
# SECURITY_HEADERS_ENABLED: kill switch (default true).
# CSP_REPORT_ONLY: CSP arranca em report-only (true) para nao quebrar paginas
#   Jinja legadas; vire false para enforcing apos validar.
# CONTENT_SECURITY_POLICY: politica CSP custom (vazio = default em src/web/security_headers.py).
SECURITY_HEADERS_ENABLED=true
CSP_REPORT_ONLY=true
CONTENT_SECURITY_POLICY=
MAX_CONTENT_LENGTH=1048576
FRONTEND_ORIGIN=http://localhost:3001,http://localhost:3000

# Ambiente Flask: "production" ativa rejeição estrita de webhooks sem
# assinatura válida (src/web/routes/payments.py). Em dev, deixe vazio.
FLASK_ENV=

# ──────────────────────────────────────────────
# RATE LIMITS
# ──────────────────────────────────────────────
WEBHOOK_RATE_LIMIT=60
WEBHOOK_RATE_WINDOW_S=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_S=60

# ──────────────────────────────────────────────
# CHAT / INTAKE WEBSOCKET
# ──────────────────────────────────────────────
CHAT_SESSION_TTL_S=3600
CHAT_CLEANUP_INTERVAL_S=300
TRIAGE_LINK_TTL_S=259200

# ──────────────────────────────────────────────
# WHATSAPP — META (WhatsApp Business API)
# Painel: https://developers.facebook.com/apps/
# ──────────────────────────────────────────────
META_WHATSAPP_KEY=change_me_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=change_me_phone_number_id
RECIPIENT_PHONE=5511999999999

# Chave Secreta do App: Meta for Developers → Seu App → Configurações → Chave Secreta do App
# Usada para validação HMAC-SHA256 do webhook (rota /webhook/meta)
WHATSAPP_APP_SECRET=change_me_app_secret
WHATSAPP_WEBHOOK_REQUIRE_SIGNATURE=true

# Token de verificação de registro do webhook (você define este valor)
VERIFY_TOKEN=change_me_verify_token

# ──────────────────────────────────────────────
# E-MAIL (SMTP)
# ──────────────────────────────────────────────
DOCTOR_EMAIL=doctor@example.com
EMAIL_FROM=no-reply@example.com
EMAIL_PASSWORD=change_me_smtp_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ──────────────────────────────────────────────
# INTELIGÊNCIA ARTIFICIAL
# ──────────────────────────────────────────────
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-change_me
OPENAI_TIMEOUT=30

# Google Gemini — DOIS backends com BILLING SEPARADO (ver src/infra/genai_client.py):
#
# (A) AI Studio (default): usa GOOGLE_API_KEY. Billing/prepay PRÓPRIO do AI Studio
#     (NÃO consome créditos do Google Cloud).
GOOGLE_API_KEY=change_me_google_api_key
#
# (B) Vertex AI: usa os créditos do Google Cloud (billing no projeto GCP).
#     Para ativar, defina USE_VERTEXAI=true + PROJECT (+ ADC via
#     GOOGLE_APPLICATION_CREDENTIALS ou `gcloud auth application-default login`).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json
GEMINI_TIMEOUT=45
# Modelo Gemini do pipeline clinico (chains.py: relatorio cientifico RAG + failover
# de triagem). Default gemini-2.5-flash (1.5/2.0 descontinuados, 404). Override
# permite rollback sem deploy. Ver docs/BACKLOG_AI_MIGRATION.md.
GEMINI_MODEL=gemini-2.5-flash
# Modelo Gemini das consultas de legislacao (Google Files API). gemini-2.0-flash
# e gemini-1.5-flash foram descontinuados (404) — usar 2.5-flash. Ver doc 30 C3/IA-1.
GEMINI_FILES_MODEL=gemini-2.5-flash
# Fallback OpenAI quando o Gemini falha em query_legislation (A5 follow-up).
# So cobre normas com texto (.md/.txt); PDFs escaneados ficam fora do fallback.
LEGISLATION_FALLBACK_MODEL=gpt-4.1-mini
# Smoke real opcional dos testes regulatórios. Deixe 0/ausente no dia a dia.
RUN_REAL_GEMINI_SMOKE=0

# Modelos usados na etapa de triagem
TRIAGE_MODEL_OPENAI=gpt-4o-mini
TRIAGE_MODEL_GEMINI=gemini-2.5-flash

# Cache de prompts (src/ai/chains.py), TTL em segundos
PROMPT_CACHE_TTL=300

# Execução clínica:
# - specialists: fluxo principal por agentes especialistas (padrão)
# - legacy: pipeline monolítico anterior
AI_EXECUTION_MODE=specialists

# ──────────────────────────────────────────────
# TELEMETRIA PÓS-CONSULTA
# ──────────────────────────────────────────────
# Hora UTC em que os follow-ups D+3/D+7/D+15 são disparados
TELEMETRY_FOLLOWUP_SEND_HOUR=10
# Intervalo (minutos) do worker que despacha eventos pendentes
TELEMETRY_DISPATCH_INTERVAL_M=15
# Tamanho máximo do batch de IoT processado por ciclo
TELEMETRY_IOT_BATCH_MAX=500

# ──────────────────────────────────────────────
# FILA DE TAREFAS (src/infra/tasks.py)
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
TASK_RESULT_TTL=86400
TASK_FAILURE_TTL=172800
TASK_DEFAULT_TIMEOUT=300
TASK_MAX_RETRIES=3

# ──────────────────────────────────────────────
# RAG / PUBMED
# ──────────────────────────────────────────────
# E-mail usado como identificador no protocolo E-utilities da NCBI
PUBMED_EMAIL=cannabia@system.local

# ──────────────────────────────────────────────
# PAGAMENTOS — PIX / WEBHOOKS POR PROVIDER
# ──────────────────────────────────────────────
# A verificação HMAC do webhook de pagamentos (src/web/routes/payments.py)
# lê PAYMENT_WEBHOOK_SECRET_<PROVIDER_UPPER> do ambiente. Adicione uma
# chave por provider integrado. Exemplos:
PAYMENT_WEBHOOK_REQUIRE_SIGNATURE=true
PAYMENT_WEBHOOK_SECRET_MERCADOPAGO=change_me_mp_webhook_secret
PAYMENT_WEBHOOK_SECRET_ASAAS=change_me_asaas_webhook_secret
PAYMENT_WEBHOOK_SECRET_PAGSEGURO=change_me_pagseguro_webhook_secret

# ──────────────────────────────────────────────
# BACKUP LOCAL VALIDADO
# ──────────────────────────────────────────────
# Opcional: pasta com pg_dump/pg_restore se nao estiverem no PATH.
# Exemplo Windows: C:\Program Files\PostgreSQL\18\bin
PG_BIN=

# ──────────────────────────────────────────────
# FRONTEND (lido pelo Next.js em build/dev)
# ──────────────────────────────────────────────
# Base da API exposta ao browser (fallback: "/api/v1")
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# Origem do backend para proxy em SSR/rewrite
BACKEND_ORIGIN=http://localhost:5000
# Host:port da API para redirecionamentos server-side
CANNABIA_API_HOSTPORT=localhost:5000

# ──────────────────────────────────────────────
# STORAGE DE ARQUIVOS (uploads do onboarding medico)
# ──────────────────────────────────────────────
# Sprint D M1: provider plugavel (src/infra/storage.py).
#   noop  (default): nao configurado; upload retorna 503 com mensagem clara
#   local: filesystem local (dev)
#   r2:    Cloudflare R2 (prod)
STORAGE_PROVIDER=noop

# Local (so usado quando STORAGE_PROVIDER=local)
# Diretorio onde os arquivos sao gravados.
STORAGE_LOCAL_ROOT=uploads_local
# Prefixo publico devolvido nas URLs (Flask static ou proxy do front).
STORAGE_LOCAL_PUBLIC_BASE=/uploads

# Cloudflare R2 (so usado quando STORAGE_PROVIDER=r2)
# Precisa instalar boto3: pip install boto3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Opcional: dominio publico do R2 (CDN ou bucket public). Vazio = URL s3://
R2_PUBLIC_BASE_URL=

# ──────────────────────────────────────────────
# OBSERVABILIDADE — SENTRY (opcional em dev)
# ──────────────────────────────────────────────
# Vazio em dev = Sentry desligado (init silencioso).
# Em prod, src/config.py exige DSN nao-vazio.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# 0.0 a 1.0 — fracao de eventos de erro enviados (default 1.0)
SENTRY_SAMPLE_RATE=1.0
# 0.0 a 1.0 — fracao de transacoes APM (default 0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ──────────────────────────────────────────────
# KNOWLEDGE / RAG — caminhos opcionais
# ──────────────────────────────────────────────
# Diretorio com PDFs/JSONs de legislacao para ingest (knowledge/google_files.py).
# Vazio = ingest desativado.
LEGISLATION_DIR=

# Tamanho minimo de coorte para agregar caso clinico anonimizado
# (knowledge/case_aggregator.py). Default 5 protege LGPD/k-anonymity.
CASE_AGGREGATE_MIN_K=5

# ──────────────────────────────────────────────
# FEATURE FLAGS
# ──────────────────────────────────────────────
# Liga a UI admin de prompts (src/ai/prompt_registry.py). Em prod default
# desligado ate a tela ser validada com QA.
FF_PROMPT_REGISTRY_ADMIN=false
