# =============================================================
# CannabIA — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do arquivo .env no repositório.
# =============================================================

# ──────────────────────────────────────────────
# BANCO DE DADOS (MySQL)
# ──────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=cannabia

# ──────────────────────────────────────────────
# SEGURANÇA DA APLICAÇÃO
# ──────────────────────────────────────────────
SECRET_KEY=change_me_strong_random_secret_min_32_chars
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
MAX_CONTENT_LENGTH=1048576

# ──────────────────────────────────────────────
# RATE LIMITS
# ──────────────────────────────────────────────
WEBHOOK_RATE_LIMIT=60
WEBHOOK_RATE_WINDOW_S=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_S=60

# ──────────────────────────────────────────────
# WHATSAPP — META (WhatsApp Business API)
# Painel: https://developers.facebook.com/apps/
# ──────────────────────────────────────────────
META_WHATSAPP_KEY=change_me_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=change_me_phone_number_id
RECIPIENT_PHONE=5511999999999

# Chave Secreta do App: Meta for Developers → Seu App → Configurações → Chave Secreta do App
# Usada para validação HMAC-SHA256 do webhook (rota /webhook/meta)
WHATSAPP_APP_SECRET=change_me_app_secret

# Token de verificação de registro do webhook (você define este valor)
VERIFY_TOKEN=change_me_verify_token

# ──────────────────────────────────────────────
# E-MAIL (SMTP)
# ──────────────────────────────────────────────
DOCTOR_EMAIL=doctor@example.com
EMAIL_FROM=no-reply@example.com
EMAIL_PASSWORD=change_me_smtp_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ──────────────────────────────────────────────
# INTELIGÊNCIA ARTIFICIAL
# ──────────────────────────────────────────────
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-change_me

# Google Gemini — https://aistudio.google.com/app/apikey
# (reservado para a próxima fase: RAG + Banco Vetorial)
GOOGLE_API_KEY=change_me_google_api_key
