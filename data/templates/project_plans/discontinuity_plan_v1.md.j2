  - triggers: list de {scenario, condition, responsible}
  - cultivation_shutdown: dict com steps (list), timeframe_days, responsible
  - disposal: dict com procedures (list), oversight, regulatory_reference
  - transition: dict com description, target_regime, steps (list)
  - member_communication: dict com channels (list), notice_period_days, message_template
  - care_continuity: dict com description, referral_partners (list)
  - records_preservation: dict com retention_years, storage_method, access_policy
  - responsibilities: list de {role, duty}
  - schedule: list de {phase, duration_days, description}
  - generated_at: ISO UTC
  - document_version: 'v1'
