# =============================================================
# CannabIA — .gitignore
# =============================================================

# RDCs ANVISA 2026 (1.011–1.015): PDFs escaneados grandes (~30MB no total),
# ingeridos no RAG (Google Files API) e arquivados fora do repo. Proveniencia
# em data/legislation/sources.json. Ver A5/SCC-1.
data/legislation/RDC_101*_2026_ANVISA.pdf

# ──────────────────────────────────────────────
# SEGURANÇA — Variáveis de Ambiente (NUNCA commitar)
# ──────────────────────────────────────────────
.env

# ──────────────────────────────────────────────
# PYTHON
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Ambientes Virtuais
env/
venv/
.venv/
ENV/

# Distribuição / Empacotamento
dist/
build/
*.egg-info/
*.egg

# ──────────────────────────────────────────────
# BANCO VETORIAL (ChromaDB — próxima fase)
# ──────────────────────────────────────────────
chroma_db/
*.chroma

# ──────────────────────────────────────────────
# LOGS E ARQUIVOS TEMPORÁRIOS
# ──────────────────────────────────────────────
*.log
*.err
cannabia.log
.pytest_tmp/
pytest_tmp_local/
tmppytest-cannabia/
pytest-cache-files-*/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ──────────────────────────────────────────────
# IDEs E EDITORES
# ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ──────────────────────────────────────────────
# SISTEMA OPERACIONAL
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────
# NODE (caso venha a usar JS)
# ──────────────────────────────────────────────
node_modules/
.next/
frontend/.env.local
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo
npm-debug.log
yarn-error.log

# ──────────────────────────────────────────────
# MemPalace local data
# ──────────────────────────────────────────────
.mempalace/
entities.json
data/file_catalog.json

# ──────────────────────────────────────────────
# Backups Postgres (binarios e temp; CHECKSUMS.txt e snapshots .txt commitam)
# ──────────────────────────────────────────────
backups/postgres/*.dump
backups/postgres/*.d
backups/postgres/.tmp/
backups/postgres/incident_*/

# ──────────────────────────────────────────────
# Claude Code config local
# ──────────────────────────────────────────────
.claude/
